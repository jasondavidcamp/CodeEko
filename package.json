{
  "name": "llm-coding-agent-runtime",
  "displayName": "LLM Coding Agent Runtime",
  "description": "Repository coding agent with guarded edits and native review for a configured OpenAI-compatible endpoint.",
  "version": "0.4.35",
  "publisher": "internal-pilot",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/jasondavidcamp/llm-coding-agent-runtime.git"
  },
  "license": "UNLICENSED",
  "engines": {
    "vscode": "^1.106.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false
    },
    "virtualWorkspaces": false
  },
  "activationEvents": [
    "onCommand:llmRuntime.open",
    "onView:llmRuntime.conversation",
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "llmRuntime.open",
        "title": "LLM Runtime: Open Conversation"
      },
      {
        "command": "llmRuntime.setKey",
        "title": "LLM Runtime: Set API Key"
      },
      {
        "command": "llmRuntime.selectModel",
        "title": "LLM Runtime: Select Model"
      },
      {
        "command": "llmRuntime.exportStartupDiagnostics",
        "title": "LLM Runtime: Export Startup Diagnostics"
      }
    ],
    "configuration": {
      "title": "LLM Coding Agent Runtime",
      "properties": {
        "llmRuntime.endpoint": {
          "type": "string",
          "default": "",
          "scope": "application",
          "description": "HTTPS API base URL (origin or /v1). Configure your endpoint before connecting."
        },
        "llmRuntime.model": {
          "type": "string",
          "default": "",
          "scope": "application",
          "description": "Selected model; also the fallback when discovery fails."
        },
        "llmRuntime.requestTimeout": {
          "type": "number",
          "default": 60000,
          "minimum": 1000,
          "maximum": 300000,
          "scope": "application"
        },
        "llmRuntime.debugRejectedResponses": {
          "type": "boolean",
          "default": false,
          "scope": "application",
          "description": "Save up to three rejected model responses per task in private extension storage for debugging. The configured API key is redacted, but source code and other sensitive text may remain. Disabling stops new captures; existing diagnostic files remain until deleted."
        },
        "llmRuntime.pesterVersion": {
          "type": "string",
          "enum": [
            "Auto",
            "4",
            "5"
          ],
          "default": "Auto",
          "scope": "application",
          "description": "Auto selects the newest installed supported Pester version. Choose 4 or 5 for a suite that requires that major version. Missing selected versions are reported rather than silently substituted."
        },
        "llmRuntime.validationExecutionPolicy": {
          "type": "string",
          "enum": [
            "Inherit",
            "RemoteSigned"
          ],
          "default": "Inherit",
          "scope": "application",
          "description": "Inherit workstation execution policy by default. RemoteSigned applies only to validation child processes, permits local unsigned tests, and does not override Group Policy or change machine settings."
        },
        "llmRuntime.installValidationModules": {
          "type": "boolean",
          "default": false,
          "scope": "application",
          "description": "Allow one CurrentUser installation attempt for missing selected Pester/PSScriptAnalyzer modules from PSGallery per task. Requires network access; failures are reported as reduced validation coverage."
        },
        "llmRuntime.permissionMode": {
          "type": "string",
          "enum": [
            "Review",
            "Workspace",
            "Full access"
          ],
          "default": "Full access",
          "scope": "application",
          "description": "Review is read-only. Workspace confirms destructive edits. Full access allows guarded repository edits and validation without operation confirmations."
        }
      }
    },
    "viewsContainers": {
      "secondarySidebar": [
        {
          "id": "llmRuntime",
          "title": "LLM Coding Agent Runtime",
          "icon": "media/conversation.svg"
        }
      ]
    },
    "views": {
      "llmRuntime": [
        {
          "type": "webview",
          "id": "llmRuntime.conversation",
          "name": "Conversation",
          "contextualTitle": "LLM Coding Agent Runtime"
        }
      ]
    }
  },
  "scripts": {
    "build": "tsc -p .",
    "test": "npm run build && node --test dist/test/*.test.js",
    "test:live": "npm run build && node dist/test/live/smoke.js",
    "test:live:editing": "npm run build && node dist/test/live/editing.js",
    "test:live:validation": "npm run build && node dist/test/live/validation.js",
    "test:host": "npm run build && node dist/test/live/runHost.js",
    "test:recovery": "npm run build && node dist/test/live/runRecovery.js",
    "package": "npm run build && vsce package --allow-missing-repository",
    "vscode:prepublish": "npm run build",
    "test:live:read-recovery": "npm run build && node dist/test/live/readRecovery.js",
    "test:live:literal-recovery": "npm run build && node dist/test/live/literalRecovery.js",
    "test:live:test-repair": "npm run build && node dist/test/live/testRepair.js",
    "debug:replay": "npm run build && node dist/test/replayRejected.js"
  },
  "dependencies": {
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/vscode": "^1.95.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.2.0",
    "typescript": "^5.7.0"
  }
}
